        "total_hpp": { "type": "number" },
        "normal_price": { "type": "number" },
        "stock": { "type": "number" },
        "expiry_date": { "type": "string" },
        "target_profit": { "type": "number" },
        "target_margin": { "type": "number" },
        "image_url": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
