      "properties": {
        "storeName": { "type": "string" },
        "defaultSellerTier": { "type": "string" },
        "expiryWarningMonths": { "type": "number" },
        "targetMarginDefault": { "type": "number" },
        "autoSync": { "type": "boolean" }
      }
    },
    "marketing_events": {
      "title": "Marketing and Promo Events",
      "description": "Event calendar, promotional campaigns, reminders, checklists, and products",
      "type": "object",
      "properties": {
